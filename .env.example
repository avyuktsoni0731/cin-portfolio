# Site URL (required in production for OG tags, sitemap, share previews)
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# MongoDB Atlas connection string
# Example: mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# Optional — defaults to "cin-portfolio"
MONGODB_DB_NAME=cin-portfolio
